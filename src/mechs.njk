---
pagination:
  data: mechs
  size: 1
  alias: mech
  addAllPagesToCollections: true
permalink: "/mechs/{{ mech.name | slugify }}/"
layout: base.njk
eleventyComputed:
  title: "{{ mech.name }} - MECH ARENA"
  description: "Perfil del mecha {{ mech.name }} - {{ mech.role }}"
---

<section class="mech-profile">
  <a href="/#coleccion" class="back-link">← Volver al Arsenal</a>

  <div class="profile-header">
    <div class="profile-hex mc-{{ mech.color }}">
      <div class="profile-hex-outer" style="view-transition-name: m-{{ mech.name | slugify }}">
        <div class="profile-hex-inner">
          <img src="{{ mech.image | url }}" alt="{{ mech.name }}" loading="eager">
        </div>
        <div class="profile-hex-tab"></div>
      </div>
    </div>

    <div class="profile-info">
      <h1>{{ mech.name }}</h1>
      <div class="profile-role">{{ mech.role }}</div>
      <div class="profile-stars">
        {% for i in range(mech.stars) %}
        <span class="star">★</span>
        {% endfor %}
        {% for i in range(5 - mech.stars) %}
        <span class="star empty">★</span>
        {% endfor %}
      </div>
      <div class="profile-level">NIVEL <span>{{ mech.level }}</span></div>
      <div class="profile-desc">{{ mech.description }}</div>
    </div>
  </div>

  <div class="profile-stats-grid">
    <div class="profile-stat-card">
      <div class="ps-icon">⚔️</div>
      <div class="ps-value">{{ mech.level * 320 + mech.stars * 150 }}</div>
      <div class="ps-label">Daño</div>
    </div>
    <div class="profile-stat-card">
      <div class="ps-icon">🛡️</div>
      <div class="ps-value">{{ mech.level * 180 + mech.stars * 100 }}</div>
      <div class="ps-label">Defensa</div>
    </div>
    <div class="profile-stat-card">
      <div class="ps-icon">⚡</div>
      <div class="ps-value">{{ mech.level * 45 + mech.stars * 20 }}</div>
      <div class="ps-label">Velocidad</div>
    </div>
    <div class="profile-stat-card">
      <div class="ps-icon">🎯</div>
      <div class="ps-value">{{ 70 + mech.level * 3 + mech.stars * 2 }}%</div>
      <div class="ps-label">Precisión</div>
    </div>
  </div>

  <div class="profile-skills">
    <h2>ESPECIFICACIONES TÉCNICAS</h2>
    <div class="profile-skill-list">
      <div class="profile-skill">
        <span class="skill-label">Potencia de Fuego</span>
        <div class="skill-bar"><div class="skill-fill" data-width="{{ 50 + mech.level * 5 + mech.stars * 4 }}"></div></div>
        <span class="skill-value">{{ 50 + mech.level * 5 + mech.stars * 4 }}%</span>
      </div>
      <div class="profile-skill">
        <span class="skill-label">Resistencia</span>
        <div class="skill-bar"><div class="skill-fill" data-width="{{ 40 + mech.level * 4 + mech.stars * 6 }}"></div></div>
        <span class="skill-value">{{ 40 + mech.level * 4 + mech.stars * 6 }}%</span>
      </div>
      <div class="profile-skill">
        <span class="skill-label">Movilidad</span>
        <div class="skill-bar"><div class="skill-fill" data-width="{{ 30 + mech.level * 3 + mech.stars * 8 }}"></div></div>
        <span class="skill-value">{{ 30 + mech.level * 3 + mech.stars * 8 }}%</span>
      </div>
      <div class="profile-skill">
        <span class="skill-label">Precisión</span>
        <div class="skill-bar"><div class="skill-fill" data-width="{{ 60 + mech.level * 2 + mech.stars * 5 }}"></div></div>
        <span class="skill-value">{{ 60 + mech.level * 2 + mech.stars * 5 }}%</span>
      </div>
    </div>
  </div>
</section>
