---
pagination:
  data: mechs
  size: 1
  alias: mech
  addAllPagesToCollections: true
permalink: "/mechs/{{ mech.name | slugify }}/"
layout: base.njk
eleventyComputed:
  title: "{{ mech.name }} - MECH ARENA"
  description: "Perfil del mecha {{ mech.name }} - {{ mech.role }}"
---

<section class="mech-profile">
  <a href="{{ '/#coleccion' | url }}" class="back-link">← Volver al Arsenal</a>

  <div class="profile-header">
    <div class="profile-hex mc-{{ mech.color }}">
      <div class="profile-hex-outer" style="view-transition-name: m-{{ mech.name | slugify }}">
        <div class="profile-hex-inner">
          <img src="{{ mech.image | url }}" alt="{{ mech.name }}" loading="eager">
        </div>
        <div class="profile-hex-tab"></div>
      </div>
    </div>

    <div class="profile-info">
      <h1>{{ mech.name }}</h1>
      <div class="profile-role">{{ mech.role }}</div>
      <div class="profile-stars">
        {% for i in range(mech.stars) %}
        <span class="star">★</span>
        {% endfor %}
        {% for i in range(5 - mech.stars) %}
        <span class="star empty">★</span>
        {% endfor %}
      </div>
      <div class="profile-level">NIVEL <span>{{ mech.level }}</span></div>
      <div class="profile-desc">{{ mech.description }}</div>
    </div>
  </div>

  <div class="profile-stats-numbers">
    <h2>ESTADÍSTICAS</h2>
    
    <div class="stats-grid">
      {% if mech.wikiStats %}
      <div class="stat-item">
        <span class="stat-label">SALUD</span>
        <span class="stat-value">{{ mech.wikiStats.hp | default(0) | round }}</span>
      </div>

      <div class="stat-item">
        <span class="stat-label">VELOCIDAD</span>
        <span class="stat-value">{{ mech.wikiStats.speed | default(0) }}</span>
      </div>

      <div class="stat-item">
        <span class="stat-label">ENERGÍA</span>
        <span class="stat-value">{{ mech.wikiStats.energy | default(0) }}</span>
      </div>

      <div class="stat-item">
        <span class="stat-label">PODER</span>
        <span class="stat-value">{{ mech.wikiStats.power | default(0) | round }}</span>
      </div>

      <div class="stat-item">
        <span class="stat-label">DURACIÓN HAB</span>
        <span class="stat-value">{{ mech.wikiStats.abilityDuration | default(0) }}</span>
      </div>

      <div class="stat-item">
        <span class="stat-label">RECARGA HAB</span>
        <span class="stat-value">{{ mech.wikiStats.abilityCooldown | default(0) }}</span>
      </div>

      <div class="stat-item">
        <span class="stat-label">DAÑO HAB</span>
        <span class="stat-value">{{ mech.wikiStats.abilityDamage | default(0) }}</span>
      </div>

      <div class="stat-item">
        <span class="stat-label">ALCANCE HAB</span>
        <span class="stat-value">{{ mech.wikiStats.abilityRange | default(0) }}</span>
      </div>

      <div class="stat-item">
        <span class="stat-label">PENETRACIÓN</span>
        <span class="stat-value">{{ mech.wikiStats.shieldPenetration | default(0) }}</span>
      </div>
      {% else %}
      <div class="stat-item">
        <span class="stat-label">SALUD</span>
        <span class="stat-value">{{ (mech.level * 450 + mech.stars * 200) | round }}</span>
      </div>

      <div class="stat-item">
        <span class="stat-label">VELOCIDAD</span>
        <span class="stat-value">{{ mech.level * 45 + mech.stars * 20 }}</span>
      </div>

      <div class="stat-item">
        <span class="stat-label">ENERGÍA</span>
        <span class="stat-value">{{ mech.level * 100 + mech.stars * 50 }}</span>
      </div>

      <div class="stat-item">
        <span class="stat-label">PODER</span>
        <span class="stat-value">{{ mech.level * 280 + mech.stars * 120 }}</span>
      </div>
      {% endif %}
    </div>
  </div>
</section>
