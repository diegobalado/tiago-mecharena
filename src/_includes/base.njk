<!DOCTYPE html>
<html lang="{{ lang or 'es' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" {{ 'content="' + description + '"' if description else '' }}>
  <link rel="stylesheet" href="{{ '/css/styles.css' | url }}">
</head>
<body>

  <div class="bg-grid"></div>
  <div class="bg-glow bg-glow-1"></div>
  <div class="bg-glow bg-glow-2"></div>
  <div class="scroll-indicator" id="scrollIndicator"></div>

  <header>
    <div class="logo">
      {{ site.title }}
      <span>{{ site.subtitle }}</span>
    </div>
    <nav>
      {% for item in navigation %}
      <a href="{{ item.url }}">{{ item.label }}</a>
      {% endfor %}
    </nav>
  </header>

  {{ content | safe }}

  <footer id="contacto">
    <div class="socials">
      {% for social in site.socials %}
      <a href="{{ social.url }}" aria-label="{{ social.label }}">{{ social.icon }}</a>
      {% endfor %}
    </div>
    <p>{{ site.footer }}</p>
  </footer>

  <script src="{{ '/js/main.js' | url }}"></script>
</body>
</html>
